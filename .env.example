# Copiez ce fichier en .env.local (développement) ou renseignez ces variables
# chez votre hébergeur (Vercel → Settings → Environment Variables).

# --- Administration (/admin) ---------------------------------------------
# Mot de passe de l'espace équipe. Choisissez une phrase longue.
ADMIN_PASSWORD=
# Facultatif : clé de signature des sessions (sinon dérivée du mot de passe).
# Changer cette valeur déconnecte tout le monde.
ADMIN_SECRET=

# --- Stockage des articles, réglages et messages --------------------------
# Sans ces variables, les données sont enregistrées dans le dossier .data/
# (parfait en local ou sur un serveur classique, mais PAS sur Vercel).
# Base Redis gratuite : https://upstash.com (ou Vercel → Storage → Upstash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- YouTube ---------------------------------------------------------------
# Facultatif mais recommandé : clé « YouTube Data API v3 » (Google Cloud, gratuite).
# Sans clé, le site utilise le flux public de la chaîne (15 dernières vidéos).
YOUTUBE_API_KEY=
# Facultatif : ID de la chaîne (UC…). Sinon il est trouvé depuis le @ de la chaîne.
YOUTUBE_CHANNEL_ID=

# --- Divers ----------------------------------------------------------------
# Adresse publique du site (pour les aperçus de partage).
NEXT_PUBLIC_SITE_URL=https://www.exemple.tg
